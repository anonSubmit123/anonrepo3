{
    "version": 1,
    "disable_existing_loggers": false,
    "formatters": {
        "simple": {
            "format": "%(asctime)s|%(name)s|%(levelname)s|%(filename)s|%(lineno)d|%(message)s"
        }
    },

    "handlers": {
        "console": {
            "class": "logging.StreamHandler",
            "level": "DEBUG",
            "formatter": "simple",
            "stream": "ext://sys.stdout"
        },

        "file_handler": {
            "class": "logging.handlers.RotatingFileHandler",
            "level": "DEBUG",
            "formatter": "simple",
            "filename": "/tmp/oraplan.log",
            "maxBytes": 104857600,
            "backupCount": 20,
            "encoding": "utf8"
        }
    },

    "loggers": {
        "tensorflow": {
            "level": "ERROR",
            "propagate": true
        },
        "spcoreutil": {
            "level": "ERROR",
            "propagate": true
        },
        "oraplan": {
            "level": "DEBUG",
            "propagate": true
        },
        "test": {
            "level": "DEBUG",
            "propagate": true
        },
        "__main__": {
            "level": "ERROR",
            "propagate": true
        }
    },

    "root": {
        "level": "ERROR",
        "handlers": ["console", "file_handler"]
    }
}